{
  "name": "@flooper/api",
  "version": "0.0.0",
  "private": true,
  "description": "Flooper's backend: the public ingest endpoint and the portal API, on Cloudflare Workers + D1.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "predev": "node -e \"require('fs').mkdirSync('../portal/dist',{recursive:true})\"",
    "dev": "wrangler dev --port 8787",
    "deploy": "pnpm -w run build && wrangler deploy --env production",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply flooper --local",
    "db:migrate:remote": "wrangler d1 migrations apply flooper --remote --env production",
    "db:seed": "wrangler d1 execute flooper --local --file=seed/dev.sql",
    "db:reset": "node -e \"require('fs').rmSync('.wrangler/state',{recursive:true,force:true})\" && pnpm db:migrate && pnpm db:seed"
  },
  "dependencies": {
    "@flooper/shared": "workspace:*",
    "hono": "4.13.14",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.11",
    "vitest": "5.0.5",
    "wrangler": "4.156.0"
  }
}
