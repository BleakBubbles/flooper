{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "flooper",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },

  // One Worker serves both the API (/api/*) and the portal's static files, so
  // the portal and its API share an origin: no CORS, and session cookies just work.
  "assets": {
    "directory": "../portal/dist",
    "not_found_handling": "single-page-application",
    // /__scheduled: so `wrangler dev --test-scheduled` can run the daily digest
    // locally (nothing answers it in production but the API's "not found").
    "run_worker_first": ["/api/*", "/__scheduled"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flooper",
      // Local dev and tests use a local SQLite file, so any ID works here.
      // The real database's ID is under env.production below.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  // A visitor's notes to one site: at most 10 a minute. Cloudflare's rate
  // limiter, counted at its edge, so sending a note costs no database write
  // for it. (Counts are per Cloudflare location, so not exact worldwide: fine
  // for stopping one visitor flooding a widget.) namespace_id is any number
  // unique to this limiter in the account.
  "ratelimits": [
    { "name": "VISITOR_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],

  // Non-secret config. Secrets (GITHUB_CLIENT_SECRET etc.) go in .dev.vars
  // locally and `wrangler secret put` in production.
  "vars": {
    "ENVIRONMENT": "development",
    // Where to send people after they log in.
    "APP_URL": "http://localhost:5173/",
    // Extra origins allowed to make cookie-authenticated portal requests.
    // In production the portal is same-origin, so this can be empty.
    "TRUSTED_ORIGINS": "http://localhost:5173",
    // At most this many notes per site per day (UTC), whoever sends them: a
    // backstop against floods the per-visitor rate limit can't catch.
    "NOTES_PER_SITE_PER_DAY": "1000",
    // Links in emails point here. Emails come from EMAIL_FROM (a domain
    // verified with the email provider; see docs/operations.md), and replies
    // go to REPLY_TO, an address that receives mail (Cloudflare Email Routing).
    "PUBLIC_URL": "http://localhost:5173",
    "EMAIL_FROM": "Flooper <notes@flooper.app>",
    "REPLY_TO": "Flooper <hello@flooper.app>"
  },

  // The daily digest, 13:00 UTC (morning in the Americas, afternoon in Europe).
  // Run it locally: wrangler dev --test-scheduled, then GET /__scheduled.
  "triggers": { "crons": ["0 13 * * *", "* * * * *"] },

  "env": {
    "production": {
      // Same name as the top level, so the URL is flooper.<account>.workers.dev
      // rather than flooper-production.<account>.workers.dev.
      "name": "flooper",
      // The real address. Cloudflare creates the DNS record and certificate.
      // The workers.dev address keeps working too, so widgets embedded with it
      // still send notes.
      "routes": [{ "pattern": "flooper.app", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "production",
        "APP_URL": "/",
        "TRUSTED_ORIGINS": "",
        "NOTES_PER_SITE_PER_DAY": "1000",
        "PUBLIC_URL": "https://flooper.app",
        "EMAIL_FROM": "Flooper <notes@flooper.app>",
        "REPLY_TO": "Flooper <hello@flooper.app>"
      },
      "triggers": { "crons": ["0 13 * * *", "* * * * *"] },
      // Bindings aren't inherited by environments: the same limiter again.
      "ratelimits": [
        { "name": "VISITOR_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "flooper",
          "database_id": "9f3e7879-d1ae-422a-ba5a-0466bedba7eb",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
